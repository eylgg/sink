<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <!-- The world map creates its pins from a named virtual template, so this one
         has to be XML. MapPins.lua defines SinkMapPinMixin and fills the icon in.

         The look is a round icon inside a one-pixel ring (Sink's identity colour,
         set in Lua) with a one-pixel dark outline: three textures, each clipped to a circle by the
         CircleMask atlas, the mask Blizzard's party and totem frames use. A mask
         only covers its own area, so each texture gets a mask of its own size.
         Pixel snapping is off on all of them, as on Blizzard's small round
         frames, so the circle edges blend instead of stepping.

         Sizes follow Blizzard's points of interest: a 16 icon drawn inside a
         24 frame, the extra being mouse area; the ring and outline add 2 each. -->
    <Frame name="SinkMapPinTemplate" mixin="SinkMapPinMixin" enableMouseMotion="true" virtual="true">
        <Size x="24" y="24"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Outline" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0.1" g="0.1" b="0.1"/>
                </Texture>
                <MaskTexture parentKey="OutlineMask" atlas="CircleMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Outline"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Outline"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="Outline"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="BORDER">
                <!-- White here; MapPins.lua tints it with ns.accent and brightens it under the mouse. -->
                <Texture parentKey="Ring" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="1" g="1" b="1"/>
                </Texture>
                <MaskTexture parentKey="RingMask" atlas="CircleMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Ring"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Ring"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="Ring"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="BORDER" textureSubLevel="1">
                <!-- A dark disc under the icon, so an atlas with a transparent
                     background (the dungeon portal) sits on dark rather than on the ring. -->
                <Texture parentKey="IconBackground" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0.1" g="0.1" b="0.1"/>
                </Texture>
                <MaskTexture parentKey="IconBackgroundMask" atlas="CircleMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.IconBackground"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.IconBackground"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="IconBackground"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                <MaskTexture parentKey="IconMask" atlas="CircleMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" texelSnappingBias="0.0" snapToPixelGrid="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="Icon"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
        </Layers>
    </Frame>
</Ui>
